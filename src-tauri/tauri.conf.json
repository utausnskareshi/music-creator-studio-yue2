{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Music Creator Studio YuE2",
  "mainBinaryName": "Music Creator Studio YuE2",
  "version": "../package.json",
  "identifier": "com.utausnskareshi.musiccreatorstudioyue2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Music Creator Studio YuE2",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 600,
        "center": true,
        "preventOverflow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' mcs: http://mcs.localhost blob:; connect-src 'self' ipc: http://ipc.localhost mcs: http://mcs.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "utausnskareshi",
    "copyright": "Copyright 2026 歌うＬＩＮＥ彼氏. Apache-2.0.",
    "category": "Music",
    "shortDescription": "YuE2 music generation studio (ComfyUI backend)",
    "longDescription": "Local music generation studio for Windows built on ComfyUI and the YuE2 model. Japanese UI.",
    "resources": {
      "../comfy-nodes/mcs_yue2_nodes/": "comfy-nodes/mcs_yue2_nodes/",
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese", "English"],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
