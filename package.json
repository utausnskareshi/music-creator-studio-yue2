  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json",
    "test": "npm run typecheck && vitest run",
    "test:nodes": "node tools/test-nodes.mjs",
    "test:nsis-hooks": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/nsis_hooks_test.ps1",
    "licenses": "node tools/third-party-licenses.mjs",
    "predev": "node tools/copy-kuromoji-dict.mjs",
    "prebuild": "node tools/copy-kuromoji-dict.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tonejs/midi": "^2.0.28",
    "abcjs": "^6.7.1",
    "kuromoji": "^0.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "wavesurfer.js": "^7",
    "zustand": "^5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^24",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
